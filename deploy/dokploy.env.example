# Paste into Dokploy → your Compose service → Environment. Replace every <…> value.
# Generate the three secrets with:  node scripts/generate-secrets.mjs
# Never commit real values.

# ── Required ──
# production for the live site; staging for a sandbox deployment (allows CASHFREE_ENV=sandbox, RESELLERCLUB_ENV=demo)
APP_ENV=production
APP_URL=https://<your-domain>
API_URL=https://<your-domain>/api
COOKIE_SECURE=true
POSTGRES_PASSWORD=<hex from generate-secrets>
REDIS_PASSWORD=<hex from generate-secrets>
CREDENTIAL_ENCRYPTION_KEY=<64 hex chars from generate-secrets>
CREDENTIAL_ENCRYPTION_KEY_ID=k1
SMTP_URL=smtps://<user>:<password>@<smtp-host>:465
MAIL_FROM=OctaveOneCloud <no-reply@<your-domain>>
# Optional: inbox that receives new support tickets and customer replies
SUPPORT_NOTIFY_EMAIL=

# ── Renewals (customer-paid until Cashfree Subscriptions mandates are verified) ──
# Renewal order + reminder this many days before the period ends
RENEWAL_NOTICE_DAYS=7
# Access continues this many days after an unpaid period end, then is suspended (data kept)
RENEWAL_GRACE_DAYS=7
# Subscription ends if the renewal is still unpaid this many days after the period end
RENEWAL_LAPSE_DAYS=30
LOG_LEVEL=info

# ── Trial without a domain (http://<ip>:8585) — see docs/deploy-vps.md "Run on IP:port" ──
# APP_URL=http://<server-ip>:8585
# API_URL=http://<server-ip>:8585/api
# COOKIE_SECURE=false
# OOC_ALLOW_INSECURE_HTTP=true
# WEB_PUBLISH=8585

# ── First deployment only: seed the draft (non-purchasable) catalogue, then set back to false ──
SEED_DRAFT_CATALOGUE=true
# fallback = apply migrations without downloading Prisma's engine; native = `prisma migrate deploy`
MIGRATE_MODE=fallback

# ── PostgreSQL (runs inside this stack) — sizing for a 4–8 GB VPS; see docs/deploy-vps.md for bigger servers ──
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
# Nightly pg_dump into the pgbackups volume: hour in UTC (21 = 02:30 IST) and days to keep
BACKUP_HOUR_UTC=21
BACKUP_KEEP_DAYS=14

# ── Tax identity (confirm with your accountant) ──
# Printed on every GST invoice. Required once CASHFREE_ENV is not disabled; until set, paid orders wait for invoices.
SELLER_LEGAL_NAME=
# One line, e.g. "12 MG Road, Bengaluru, Karnataka 560001"
SELLER_ADDRESS=
SELLER_GSTIN=
# Two-digit GST state code, e.g. 29 for Karnataka
SELLER_STATE_CODE=
# Invoice / credit-note number prefixes (1–4 capitals or digits) → OOC/26-27/00001. Never change mid-year.
INVOICE_PREFIX=OOC
CREDIT_NOTE_PREFIX=OCN

# ── Payments: keep disabled until the Cashfree merchant account is verified ──
CASHFREE_ENV=disabled
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_SECRET=
CASHFREE_SUBSCRIPTIONS_ENABLED=false

# ── Supplier: keep disabled until capabilities are verified (docs/provider-capabilities.md) ──
RESELLERCLUB_ENV=disabled
RESELLERCLUB_BASE_URL=
RESELLERCLUB_AUTH_USERID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_ALLOW_LIVE_MUTATIONS=false
# Currency your ResellerClub account is billed in (prices API does not say). Only INR feeds the catalogue.
RESELLERCLUB_CURRENCY=INR
# Hours between automatic price-list refreshes (0 = only on demand). See docs/resellerclub-pricing.md
RESELLERCLUB_PRICE_SYNC_HOURS=24

# ── Hosted app adapters (worker), one pair per app ──
# APP_ADAPTER_CRM_URL=https://crm.internal.example.com/ooc-adapter
# APP_ADAPTER_CRM_SECRET=   (≥ 32 random characters; also authenticates the app's calls to /api/v1/app-api)

# Reserved names (S3_*, MODEL_GATEWAY_*, SENTRY_DSN, OTEL_EXPORTER_OTLP_ENDPOINT, CASHFREE_SUBSCRIPTION_CLIENT_*)
# are accepted but not used by any feature yet — leave them out. See docs/environment-variables.md.

# ── Optional single sign-on (OIDC) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Register the redirect URI <API_URL>/v1/auth/oidc/callback (e.g. https://app.example.com/api/v1/auth/oidc/callback)
OIDC_DISPLAY_NAME=
OIDC_SCOPES=openid email profile
# true = create accounts on first SSO sign-in; false = only existing accounts with the same verified email
OIDC_ALLOW_SIGNUP=false

# ── Customer OAuth connections (optional; one block per provider, see docs/identity-and-connectors.md) ──
# Endpoints come from the provider's documentation. Redirect URI: <API_URL>/v1/connectors/callback
# CONNECTOR_GMAIL_LABEL=Gmail
# CONNECTOR_GMAIL_AUTHORIZE_URL=
# CONNECTOR_GMAIL_TOKEN_URL=
# CONNECTOR_GMAIL_CLIENT_ID=
# CONNECTOR_GMAIL_CLIENT_SECRET=
# CONNECTOR_GMAIL_SCOPES=
# CONNECTOR_GMAIL_APPS=app.crm
# CONNECTOR_GMAIL_EXTRA_AUTH_PARAMS=access_type=offline&prompt=consent
