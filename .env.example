# ─────────────────────────────────────────────────────────────────────────────
# OctaveOneCloud configuration template. PLACEHOLDERS ONLY — never commit real values.
# Copy to .env for local development. In Dokploy, set these as service secrets.
# Names below are OctaveOneCloud application settings, not provider SDK field names;
# see docs/provider-capabilities.md for how each maps to provider headers/parameters.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
# development | staging | production (defaults from NODE_ENV). staging = production build using provider sandboxes.
APP_ENV=
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info

# ── Data stores (never expose publicly) ──
DATABASE_URL=postgresql://ooc:change-me@localhost:5432/ooc
REDIS_URL=redis://localhost:6379

# ── Sessions & credential encryption ──
SESSION_COOKIE_NAME=ooc_session
SESSION_TTL_HOURS=168
# true in any HTTPS deployment (required when NODE_ENV=production)
COOKIE_SECURE=false
# 32 random bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-locally-000000000000000
CREDENTIAL_ENCRYPTION_KEY_ID=k1

# ── Optional OIDC (existing identity provider) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── ResellerClub HTTP API ──
# disabled | demo | live.  Use DEMO credentials for tests: the test hostname does NOT protect
# against live actions if live credentials are used. Outbound server IPs must be allowlisted.
RESELLERCLUB_ENV=disabled
# Demo: https://test.httpapi.com/api   Live: https://httpapi.com/api   (verify against current docs)
RESELLERCLUB_BASE_URL=
# Sent as the auth-userid / api-key request parameters. Redacted from all logs.
RESELLERCLUB_AUTH_USERID=
RESELLERCLUB_API_KEY=
# Second explicit switch required before chargeable live supplier actions (only valid with ENV=live).
RESELLERCLUB_ALLOW_LIVE_MUTATIONS=false

# ── Cashfree Payment Gateway ──
# disabled | sandbox | production   (production only permitted when NODE_ENV=production)
CASHFREE_ENV=disabled
# Sent as x-client-id / x-client-secret headers from the server only.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Sent as x-api-version.
CASHFREE_API_VERSION=2025-01-01
# Secret used for x-webhook-signature verification (confirm which key the merchant dashboard uses).
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree Subscriptions (enable only if the merchant account has the capability) ──
CASHFREE_SUBSCRIPTIONS_ENABLED=false
CASHFREE_SUBSCRIPTION_CLIENT_ID=
CASHFREE_SUBSCRIPTION_CLIENT_SECRET=
CASHFREE_SUBSCRIPTION_API_VERSION=
CASHFREE_SUBSCRIPTION_WEBHOOK_SECRET=

# ── Seller tax identity (accountant to confirm) ──
# Printed on every GST invoice. Required once CASHFREE_ENV is not disabled; until set, paid orders wait for invoices.
SELLER_LEGAL_NAME=
# One line, e.g. "12 MG Road, Bengaluru, Karnataka 560001"
SELLER_ADDRESS=
SELLER_GSTIN=
# Two-digit GST state code, e.g. 29 for Karnataka
SELLER_STATE_CODE=
# Invoice / credit-note number prefixes (1–4 capitals or digits) → OOC/26-27/00001. Never change mid-year.
INVOICE_PREFIX=OOC
CREDIT_NOTE_PREFIX=OCN

# ── S3-compatible object storage ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ──
SMTP_URL=
MAIL_FROM=
SUPPORT_NOTIFY_EMAIL=

# ── Renewals (customer-paid until Cashfree Subscriptions mandates are verified) ──
# Renewal order + reminder this many days before the period ends
RENEWAL_NOTICE_DAYS=7
# Access continues this many days after an unpaid period end, then is suspended (data kept)
RENEWAL_GRACE_DAYS=7
# Subscription ends if the renewal is still unpaid this many days after the period end
RENEWAL_LAPSE_DAYS=30

# ── Hosted app adapters (one block per app; values are references, see docs/app-adapter-contract.md) ──
APP_ADAPTER_CRM_URL=
APP_ADAPTER_CRM_SECRET=

# ── Optional private model gateway (authenticated, never public) ──
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=

# ── Monitoring ──
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ── Docker Compose only ──
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# PostgreSQL tuning and nightly backups (defaults suit a 4–8 GB VPS)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
PG_LOG_SLOW_MS=1000
BACKUP_HOUR_UTC=21
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=true
WEB_PORT=3000
# Web → API internal URL (set automatically in docker-compose.yml)
API_INTERNAL_URL=http://localhost:4000

# ── Development only (ignored when NODE_ENV=production) ──
# Comma-separated adapter keys served by the in-memory reference adapter, e.g. app.crm
OOC_ENABLE_REFERENCE_ADAPTERS=
